{
  "name": "flash-sale-system",
  "version": "1.0.0",
  "description": "Hệ thống bán hàng Flash Sale xây dựng bằng Express.js, Redis (atomic stock + rate limit) và BullMQ (hàng đợi xử lý đơn hàng bất đồng bộ)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "cluster": "node src/cluster.js",
    "seed": "node seed.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
